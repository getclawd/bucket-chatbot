# Copy this file to .env and fill it in. Never commit .env.

# --- telegram -----------------------------------------------------------
# From @BotFather: send /newbot, then paste the token it gives you here.
# Also send @BotFather /setprivacy -> Disable, or bucket will only ever see
# messages in groups that mention it by name.
BUCKET_TELEGRAM_TOKEN=

# Telegram numeric user IDs allowed to run /forget, /chattiness and /wipe.
# Space or comma separated. Empty means these commands are disabled for
# everyone; set this before running a public bot.
BUCKET_ADMIN_IDS=

# --- discord ------------------------------------------------------------
# 1. https://discord.com/developers/applications -> New Application
# 2. Bot -> Reset Token -> paste it here
# 3. Bot -> Privileged Gateway Intents -> enable MESSAGE CONTENT INTENT,
#    or Discord delivers empty message bodies and Bucket learns nothing
# 4. OAuth2 -> URL Generator -> scope: bot; permissions: Send Messages +
#    Read Message History -> open the URL to invite it to your server
# Needs: pip install discord.py
BUCKET_DISCORD_TOKEN=

# Discord user IDs (a different namespace from Telegram's) allowed to run
# !forget, !chattiness and !wipe.
# Empty means these commands are disabled for everyone.
BUCKET_DISCORD_ADMIN_IDS=

# --- identity -----------------------------------------------------------
BUCKET_NAME=bucket
BUCKET_DB=bucket.sqlite3

# --- behavior -----------------------------------------------------------
# Chance of butting into a conversation it wasn't addressed in (0 to 1).
# Roughly: 0.05 wallflower, 0.18 sociable, 0.35 a lot, 0.6+ exhausting.
# /chattiness in chat overrides this and survives restarts.
BUCKET_CHATTINESS=0.18
# It stays quiet this long after an uninvited reply, so it can't flood a fast
# group. Being spoken to directly is never rate limited.
BUCKET_MIN_GAP=25
# For this long after it speaks, its chance is multiplied — a conversation is
# usually happening, so it keeps up rather than dipping in at random.
BUCKET_FOLLOWUP_WINDOW=150
BUCKET_FOLLOWUP_BOOST=2.5
# Items it can carry before it starts dropping things.
BUCKET_INVENTORY_SIZE=12
# A line repeated this many times can become an obsession.
BUCKET_OBSESSION_THRESHOLD=3
# Set to 0 to freeze the database and stop it learning anything new.
BUCKET_LEARN=1

# --- llm polish layer ---------------------------------------------------
# none | anthropic | ollama
# Re-voices the engine's output. Never invents content. Optional in every sense:
# if it's off, unreachable, or fails, the raw engine output is used unchanged.
BUCKET_LLM_BACKEND=none

# anthropic: needs `pip install anthropic` and ANTHROPIC_API_KEY in the
#            environment (or an `ant auth login` profile). Defaults to claude-opus-5.
# ollama:    needs ollama running. Leave the model empty to auto-detect.
#            Prefer a NON-reasoning model (llama3.1:8b, qwen2.5:7b, gemma3:4b) —
#            reasoning models are slow here and break character more often.
BUCKET_LLM_MODEL=
BUCKET_OLLAMA_URL=http://localhost:11434
BUCKET_LLM_TIMEOUT=45
# Fraction of replies that get polished. 0.5 gives a mix of raw and smoothed.
BUCKET_LLM_POLISH_RATE=1.0

# Discard polished lines that contain words the engine never said. This is what
# stops the LLM answering for Bucket instead of just re-voicing it. Setting this
# to 0 gives you an LLM chatbot, not Bucket.
BUCKET_LLM_STRICT=1

# --- semantic memory ----------------------------------------------------
# Lets Bucket recall things phrased differently from how it learned them.
# Needs numpy (pip install numpy) and `ollama pull nomic-embed-text`.
# Set to none for the crude bag-of-words recall the 2008 original had.
BUCKET_EMBED_BACKEND=ollama
BUCKET_EMBED_MODEL=nomic-embed-text
BUCKET_EMBED_TIMEOUT=30
# How much recall leans on meaning vs. literal shared words (0 to 1).
BUCKET_SEMANTIC_WEIGHT=0.65

# --- lexical recall -----------------------------------------------------
# Use SQLite's FTS5/BM25 index (with porter stemming) for the word-based half
# of recall, instead of the older hand-rolled IDF scan. Measured better:
# lexical_test.py puts mean precision@3 at 0.89 vs 0.67, mostly because
# stemming lets "does it rain" reach "it rains". Set to 0 to go back.
BUCKET_FTS=1
# How many recent lines (from anyone, Bucket included) it won't repeat. Small
# on purpose: reusing the group's catchphrases is what the phrase and obsession
# strategies are for, but doing it twice in one exchange reads as a stuck bot.
# 0 disables suppression entirely.
BUCKET_NO_REPEAT_WINDOW=6

# --- names it must never say ----------------------------------------------
# Handles Bucket must never say. The built-in list in bucket/blocklist.py ships
# empty, because which names matter is a fact about your corpus, not the code —
# so this is the only place they're configured.
# Comma or space separated, matched as whole words, case-insensitively. A line
# containing one is stored but never learned from, never said, and redacted out
# of /literal and /recall. Run scrub_legacy.py --apply after adding names to
# purge them from the chain, phrases and factoids retroactively.
# BUCKET_BLOCKED_NAMES=
# Recall half-life in days — a line twice this old scores a quarter as much.
# 0 (the default) disables decay: most of what makes Bucket funny is old and
# shouldn't fade. Raise it off zero if it starts feeling stuck in the past.
BUCKET_RECALL_HALF_LIFE=0
# Candidates fetched per source before reranking, as a multiple of the final
# limit. Reranking can only reorder what retrieval already found.
BUCKET_RECALL_OVERFETCH=3

# --- api key for the anthropic backend ----------------------------------
# ANTHROPIC_API_KEY=
